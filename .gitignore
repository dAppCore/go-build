.vscode/
*.log
.core/
# ...except fixtures. testdata deliberately contains a .core/build.yaml for the
# loader tests to parse, and `.core/` above was silently swallowing it — a
# `git add` appeared to work and committed nothing, so the test passed locally
# and failed in CI. Same shape as the pkg/api/ui/dist case below.
!go/pkg/build/testdata/**/.core/
!go/pkg/build/testdata/**/.core/**
.gocache-build/
.DS_Store
Thumbs.db
.Spotlight-V100
.Trashes
*.swp
*.swo
*~
*.tmp
.env
.env.local
.env.*.local
__pycache__/
*.pyc
.venv/
venv/
node_modules/
dist/
# ...except the one the go:embed in pkg/api needs. Without a file here the
# package does not compile, for us or for anyone who `go get`s the module —
# `dist/` above had been quietly swallowing it.
!go/pkg/api/ui/dist/
!go/pkg/api/ui/dist/**
/build/
*.exe
*.dll
*.so
*.dylib
*.a
*.o
*.class
*.test
coverage.out
